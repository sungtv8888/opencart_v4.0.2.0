<form id="form-news" method="post" data-oc-toggle="ajax" data-oc-load="{{ action }}" data-oc-target="#news">
  <div class="table-responsive">
    <table class="table table-bordered table-hover">
      <thead>
        <tr>
          <td class="text-center" style="width: 1px;"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', $(this).prop('checked'));" class="form-check-input"/></td>
          <td class="text-start"><a href="{{ sort_name }}"{% if sort == 'nd.name' %} class="{{ order|lower }}"{% endif %}>{{ column_name }}</a></td>
          <td class="text-start"><a href="{{ sort_author }}"{% if sort == 'n.author' %} class="{{ order|lower }}"{% endif %}>{{ column_author }}</a></td>
          <td class="text-start"><a href="{{ sort_date_available }}"{% if sort == 'n.date_available' %} class="{{ order|lower }}"{% endif %}>{{ column_date_available }}</a></td>
          <td class="text-end"><a href="{{ sort_sort_order }}"{% if sort == 'n.sort_order' %} class="{{ order|lower }}"{% endif %}>{{ column_sort_order }}</a></td>
          <td class="text-center">{{ column_status }}</td>
          <td class="text-end">{{ column_action }}</td>
        </tr>
      </thead>
      <tbody>
        {% if news_list %}
          {% for news in news_list %}
            <tr>
              <td class="text-center"><input type="checkbox" name="selected[]" value="{{ news.news_id }}" class="form-check-input"/></td>
              <td class="text-start">{{ news.name }}</td>
              <td class="text-start">{{ news.author }}</td>
              <td class="text-start">{{ news.date_available }}</td>
              <td class="text-end">{{ news.sort_order }}</td>
              <td class="text-center">{{ news.status ? text_enabled : text_disabled }}</td>
              <td class="text-end"><a href="{{ news.edit }}" data-bs-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa-solid fa-pencil"></i></a></td>
            </tr>
          {% endfor %}
        {% else %}
          <tr><td class="text-center" colspan="7">{{ text_no_results }}</td></tr>
        {% endif %}
      </tbody>
    </table>
  </div>
  <div class="row">
    <div class="col-sm-6 text-start">{{ pagination }}</div>
    <div class="col-sm-6 text-end">{{ results }}</div>
  </div>
</form>
