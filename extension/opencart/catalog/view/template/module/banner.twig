<!--start slideshow-->

        <div class="row background-topic"
            style="background-color:#8bbcfd;background-size: 100%;   background-repeat: no-repeat; background-position-x: center;">

            <div class="container" style="padding-bottom: 10px; margin-bottom: 10px;">
                <div class="row-custom-web">

                    <div class="col-12 background-white pt-1 pr-1 pl-1 br-5">
                        <div style="--swiper-navigation-color: #fff; --swiper-pagination-color: #fff"
                            class="swiper mySwiper swiper-initialized swiper-horizontal swiper-backface-hidden"
                            data-control-load="activeSwipperThumb">
                            <div class="swiper-wrapper" id="swiper-wrapper-7d7587741de8026d" aria-live="off"
                                style="transition-duration: 0ms; transform: translate3d(-1192px, 0px, 0px); transition-delay: 0ms;">

									 {% for banner in banners %}
										<div class="swiper-slide" role="group" style="width: 1192px;">
											{% if banner.link %}
											<a href="{{ banner.link }}">
												<img src="{{ banner.image }}" title="{{ banner.title }}" class="img-fluid" alt="{{ banner.title }}">
											</a>
											{% else %}
											<img src="{{ banner.image }}" title="{{ banner.title }}" class="img-fluid" alt="{{ banner.title }}">
											{% endif %}
										</div>
										{% endfor %}



                            </div>
                            <div class="swiper-button-next" tabindex="0" role="button" aria-label="Next slide"
                                aria-controls="swiper-wrapper-7d7587741de8026d" aria-disabled="false"></div>
                            <div class="swiper-button-prev" tabindex="0" role="button" aria-label="Previous slide"
                                aria-controls="swiper-wrapper-7d7587741de8026d" aria-disabled="false"></div>
                            <span class="swiper-notification" aria-live="assertive" aria-atomic="true"></span>
                        </div>
                        <div thumbsslider=""
                            class="swiper mySwiper2 swiper-initialized swiper-horizontal swiper-free-mode swiper-watch-progress swiper-backface-hidden swiper-thumbs">
                            <div class="swiper-wrapper" id="swiper-wrapper-24fd52a2d8c79b49" aria-live="polite"
                                style="transform: translate3d(0px, 0px, 0px); transition-duration: 0ms; transition-delay: 0ms;">

								  {% for banner in banners %}
									<div class="swiper-slide" role="group" style="width: 238.4px;">
										{{ banner.title }}
									</div>
									{% endfor %}
                                 

                            </div>
                            <span class="swiper-notification" aria-live="assertive" aria-atomic="true"></span>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!--end slideshow-->