                                <img data-lazy="thumb" data-src="{{ thumb }}" data-width="120" data-height="120"  src="{{ thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}"  class="img-100"/> 
                            </div>
                        {% endif %}   
