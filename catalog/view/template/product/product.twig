        </div>
        <div class="col-md-6">
            <div class="row">
                <div class="col-md-12">
                    <h1 class="product-detail-title pl-0 mb-0">{{ heading_title }}</h1>
                </div>
                
                <div class="col-12 font-15">
                    <span class="sort-total-1">Thương hiệu: <strong class="text-danger">{{ manufacturer }}</strong></span>&nbsp;&nbsp;
                    <span class="sort-total-1 hide">|&nbsp;Xuất xứ: <strong class="text-danger"></strong></span>
                </div>  
                <div class="col-12 font-15 my-2">
                    <span class="sort-total-1">Tình trạng: <strong class="text-danger">Liên hệ để biết thêm thông tin</strong></span>&nbsp;&nbsp;
                 </div>
                <div class="col-md-12 padding-top-15 padding-top-15-mb item-sale-vote">
                    <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i>
                    <span>(5)</span>

                    <a class="sort-total-1 font-11" href="#" data-control-load="clickToComments">(Xem đánh giá)</a>
                </div>                

            </div>
                
            <div class="row">
                <div class="col-md-12 margin-15 margin-15-mb">
                    {% if not special %}
                         <span class="sale-cost-detail">{{ price }}</span> &nbsp; &nbsp; &nbsp;
                         
                    {% else %}
                         <span class="sale-cost-detail">{{ special }}</span> &nbsp; &nbsp; &nbsp;
                         <span class="sale-public-cost-detail">{{ price }}</span> &nbsp; &nbsp; &nbsp;
                         <span class="sort-total-1">-35%</span>
                    {% endif %}
                </div>

            </div>

            <div class="row">
                <div class="col col-6 text-center margin-bottom-10" style="padding-right: 5px">
                    <button type="button" style="padding-bottom: 0px; padding-top: 0px;" class="btn btn-buy-now-50 btn-license btn-cart btn-buy-now" data-product-id="{{ product_id }}" data-quantity="{{ minimum }}">
                        MUA NGAY
                    </button>
                </div>
                <div class="col col-6 text-center margin-bottom-10" style="padding-left: 5px">
                    <button type="button" style="padding-bottom: 0px; padding-top: 0px; background-color: #2F80ED;" class="btn btn-buy-now-50 btn-license btn-cart btn-add-to-cart" data-product-id="{{ product_id }}" data-quantity="{{ minimum }}">
                        <i class="fa fa-shopping-basket font-16 color-white"></i>
                        THÊM VÀO GIỎ HÀNG
                    </button>
                </div>
            </div>
            {#edit by SungTV on 2026/09/20 start#}
            <script type="text/javascript">
            $('.btn-add-to-cart, .btn-buy-now').on('click', function () {
                var button = $(this);

                $.ajax({
                    url: 'index.php?route=checkout/cart.add&language={{ language }}',
                    type: 'post',
                    data: {
                        product_id: button.data('product-id'),
                        quantity: button.data('quantity') || 1
                    },
                    dataType: 'json',
                    beforeSend: function () {
                        button.prop('disabled', true);
                    },
                    complete: function () {
                        button.prop('disabled', false);
                    },
                    success: function (json) {
                        if (json['error'] && json['error']['warning']) {
                            $.toast({message: '<i class="fa fa-times" aria-hidden="true"></i> ' + json['error']['warning'], type: 'error'});
                        }

                        if (json['success']) {
                            $('#header-cart').load('index.php?route=common/cart.info');

                            if (button.hasClass('btn-buy-now')) {
                                window.location.href = 'index.php?route=checkout/cart';
                            } else {
                                $.toast('<i class="fa fa-check" aria-hidden="true"></i> ' + json['success']);
                            }
                        }
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
