<div class="row" data-control-load="productListLoaded">
<div class="col-12">
        <div class="container background-white background-grey">
            <div class="row">
                 <div class="col-12">
                      <ul class="breadcrumb-cx background-grey breadcrumb-fixbrowser" >
                          {% for breadcrumb in breadcrumbs %}
