                                     <img src="{{ image.slide }}" title="{{ heading_title }}" alt="{{ heading_title }}"  class="img-fluid"/> &nbsp;
                                </div>
                                {% endfor %}
                        
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="swiper-wrapper" id="swiper-wrapper-a10a82f8d9742610fe" aria-live="off" >
                            {% if thumb %}
                            <div class="swiper-slide" role="group" aria-label="1 / 8" style="width: 570px; margin-right: 10px;">
                                <img src="{{ thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}"  class="img-fluid"/> 
                            </div>
                            {% endif %}   
                            {% if images %}
                                {% for image in images %}
                                 <div class="swiper-slide swiper-slide-prev" data-control-load="" data-iframe="" "="" role="group" aria-label="2 / 8" >
                                     <img src="{{ image.slide }}" title="{{ heading_title }}" alt="{{ heading_title }}"  class="img-fluid"/> &nbsp;
                                </div>
                                {% endfor %}
                        
                            {% endif %}
                        </div>
                    {% endif %}
                    <div class="swiper-button-next" tabindex="0" role="button" aria-label="Next slide" aria-controls="swiper-wrapper-a10a82f8d9742610fe" aria-disabled="false"></div>
                    <div class="swiper-button-prev" tabindex="0" role="button" aria-label="Previous slide" aria-controls="swiper-wrapper-a10a82f8d9742610fe" aria-disabled="false"></div>
                    
                <span class="swiper-notification" aria-live="assertive" aria-atomic="true"></span></div>
                <div thumbsslider="" class="swiper mySwiperThumb mySwiperThumbGray pt-3 pb-3 swiper-initialized swiper-horizontal swiper-free-mode swiper-watch-progress swiper-backface-hidden swiper-thumbs">
                    <div class="swiper-wrapper" id="swiper-wrapper-7544cd61ea72b91d" aria-live="polite" style="transform: translate3d(0px, 0px, 0px); transition-duration: 0ms; transition-delay: 0ms;">
                         {% if thumb %}
