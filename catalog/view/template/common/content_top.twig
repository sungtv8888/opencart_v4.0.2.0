{% set banner = [] %}
{% set hotproducts = [] %}
{% set topproducts = [] %}
{% for module in modules %}
{%if module.code =='banner'%}
    {% set banner = banner|merge([module.content]) %}
  
{% elseif module.code =='hot' %}
     {% set hotproducts = hotproducts|merge([module.content]) %}
{%else%}
    {% set topproducts = topproducts|merge([module.content]) %}
{% endif %}
{% endfor %}

{% for b in banner %}
      {{ b}}
{% endfor %}



